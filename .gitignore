# Hugo build output
/public/
/resources/

# Hugo module cache (optional but recommended)
/.hugo_cache/

# OS files
.DS_Store
Thumbs.db

# Editor files
.idea/
*.swp
*.swo

# Logs
*.log

# Temporary files
tmp/

.hugo_build.lock

# Raw source material (third-party STLs, references, rulebooks)
/input/

# Blender script output (published copies live in the page bundles)
/blender/**/output*/
